# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Runtime logs (contain tokens, file content, config values — never commit)
logs/*
!logs/.gitkeep

# Secret: the per-install token used to gate dashboard access
.token

# Env / secrets
.env
.env.local
.env.*.local
config.local.json
secrets/

# Claude Code per-user overrides
.claude/settings.local.json
.claude/.credentials.json
.claude/scheduled_tasks.lock

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local backups (e.g. dispatch.mjs.bak kept as a safety net during edits)
*.bak

# Scratch / throwaway (failover probes, temp JSON captures)
.tmp/

# Build artifacts (defensive — none expected)
dist/
build/

# Image attachments uploaded via the dashboard (purge manually or wait for a future cron)
attachments/

# APK build artifacts — rebuilt from sources in android/
docs/*.apk
*.apk

# Instances de test de scripts/regression.mjs (jetables)
.regress/

# Captures d'écran jetables (émulateur, essais UI) — peuvent montrer des données perso
android/*.png
/ui-*.png

# APK publiés pour /downloads (scripts/copy-build.mjs) — artefacts
builds/

# Binaires tiers (nssm) — se retéléchargent
tools/

# Copies de sauvegarde manuelles de fichiers source
*.before-*

# Config locale (chemins et noms de projets privés) — modèle : config.example.json
config.json

# Choix « Models par tâche » (0.39.0), écrits par le serveur — local
model-routing.json
model-routing.json.*.tmp

# Captures d'écran de l'UI réelle (conversations, noms de projets)
docs/*.png
docs/**/captures/
