{
  "testCommand": "node scripts/regression.mjs --targeted --no-browser",
  "targetedTestCommand": "node scripts/regression-files.mjs {files}",
  "testGlobs": [
    "scripts/_test_*.mjs",
    "scripts/_regression*.mjs",
    "tests/**"
  ],
  "versionFiles": [
    "package.json"
  ],
  "changelog": "CHANGELOG.md",
  "requirements": "docs/USER_REQUIREMENTS.md",
  "testTimeoutMin": 30,
  "lanes": {
    "dir": "../orchestrateur-dev-lanes",
    "copy": [
      "config.json",
      ".orchestrateur-instance.json",
      ".token",
      "model-routing.json",
      "language-settings.json"
    ],
    "link": [
      "node_modules"
    ],
    "releaseCheck": [
      "node",
      "scripts/regression.mjs",
      "--targeted",
      "--since",
      "{base}"
    ],
    "releaseCheckTimeoutMin": 60
  },
  "idleRegression": {
    "full": [
      "node",
      "scripts/regression.mjs",
      "--ref",
      "{ref}",
      "--out",
      "{report}"
    ],
    "bisect": [
      "node",
      "scripts/regression.mjs",
      "--ref",
      "{ref}",
      "--only-suites",
      "{suites}",
      "--out",
      "{report}"
    ],
    "inPlace": true,
    "timeoutMin": 120
  }
}
