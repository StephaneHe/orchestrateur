<?xml version="1.0" encoding="utf-8"?>
<!-- Icon foreground — Matrix monochrome variant from
     docs/Matrix-handoff/icon.html ("MATRIX · DEFAULT").  The center glyph
     doubles as a terminal prompt:  [ > █ ]  — four corner brackets frame
     a phosphor-green chevron and a bright block cursor.

     Rendered in the 108×108 adaptive-icon viewport. All strokes stay
     inside the 66×66 safe zone (21–87) so launchers that mask the icon
     into circles, squircles or teardrops don't clip anything. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Four corner brackets (stroked L-shapes) -->
    <path
        android:strokeColor="#2DFF7A" android:strokeWidth="2.5"
        android:strokeLineCap="square"
        android:fillColor="#00000000"
        android:pathData="M 32 40 L 32 32 L 40 32" />
    <path
        android:strokeColor="#2DFF7A" android:strokeWidth="2.5"
        android:strokeLineCap="square"
        android:fillColor="#00000000"
        android:pathData="M 68 32 L 76 32 L 76 40" />
    <path
        android:strokeColor="#2DFF7A" android:strokeWidth="2.5"
        android:strokeLineCap="square"
        android:fillColor="#00000000"
        android:pathData="M 76 68 L 76 76 L 68 76" />
    <path
        android:strokeColor="#2DFF7A" android:strokeWidth="2.5"
        android:strokeLineCap="square"
        android:fillColor="#00000000"
        android:pathData="M 40 76 L 32 76 L 32 68" />

    <!-- Chevron: the `>` of the prompt -->
    <path
        android:strokeColor="#2DFF7A" android:strokeWidth="5"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M 42 44 L 54 54 L 42 64" />

    <!-- Block cursor: bright phosphor bar to the right of the chevron.
         Filled white-green so it reads as "just lit". -->
    <path
        android:fillColor="#BAFFC8"
        android:pathData="M 60 40 h 6 v 28 h -6 z" />

    <!-- Magenta alert LED — tiny, top-left, matches design (shown lit
         when the app has fleet-level NEEDS_USER_INPUT). At launcher
         size it reads as an indicator dot. -->
    <path
        android:fillColor="#FF2D8B"
        android:pathData="M 26 26 m -2.5 0 a 2.5 2.5 0 1 0 5 0 a 2.5 2.5 0 1 0 -5 0" />
</vector>
